{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AmityVox",
  "version": "0.5.0",
  "identifier": "chat.amityvox.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build && rm -rf build/node_modules",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AmityVox",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; img-src 'self' tauri: asset: https: http: data: blob:; connect-src 'self' ipc: http: https: ws: wss:; media-src 'self' tauri: asset: https: http: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "dmg", "nsis"],
    "icon": [
      "icons/icon.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Self-hosted federated communication platform",
    "longDescription": "AmityVox is a self-hosted, federated, optionally-encrypted communication platform. Chat with friends, build communities, and own your data.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
